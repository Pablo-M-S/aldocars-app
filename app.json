{
  "expo": {
    "name": "AldoCars",
    "slug": "aldocars-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aldocars",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1A2B"
    },
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7fc96ba1-82b8-435b-9269-bdd6a205079d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.aldocars.app"
    },
    "android": {
      "package": "br.com.aldocars.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications", "expo-font"],
    "extra": {
      "apiUrl": "https://aldo-oficina.onrender.com",
      "router": { "origin": false },
      "eas": { "projectId": "7fc96ba1-82b8-435b-9269-bdd6a205079d" }
    }
  }
}
